# ============================================
# Environment Configuration Template
# Copy this file to .env.staging / .env.dev / .env.sandbox
# and fill in the values for your environment.
# DO NOT commit real credentials.
# ============================================

ENVIRONMENT=staging
BASE_URL=https://staging.ai4inclusion.org
REQUEST_TIMEOUT=30.0
TOKEN_REFRESH_INTERVAL=840

DEFAULT_TENANT_ID=<your-default-tenant-id>

# ============================================
# ROLE CREDENTIALS (JWT Authentication Only)
# ============================================

ADOPTER_ADMIN_USERNAME=<adopter-admin-email>
ADOPTER_ADMIN_PASSWORD=<adopter-admin-password>

ADMIN_USERNAME=<admin-email>
ADMIN_PASSWORD=<admin-password>

TENANT_ADMIN_USERNAME=<tenant-admin-email>
TENANT_ADMIN_PASSWORD=<tenant-admin-password>

MODERATOR_USERNAME=<moderator-email>
MODERATOR_PASSWORD=<moderator-password>

USER_USERNAME=<user-email>
USER_PASSWORD=<user-password>

GUEST_USERNAME=<guest-email>
GUEST_PASSWORD=<guest-password>

# ============================================
# TEST DATA - User IDs for Role Assignment Tests
# ============================================

TEST_USER_ID=<user-id-integer>
TEST_USER_EMAIL=<test-user-email>
TEST_USER_PASSWORD=<test-user-password>
TEST_ROLE_NAME=USER

TENANT_TEST_USER_ID=<tenant-user-id-integer>
TENANT_TEST_USER_EMAIL=<tenant-test-user-email>
TENANT_TEST_USER_PASSWORD=<tenant-test-user-password>

# ============================================
# TEST TOKENS (for Token Validation & RBAC Tests)
# Group A: ASR, NMT, TTS, LLM, Pipeline, OCR permissions
# Group B: Transliteration, TLD, SD, LD, ALD, NER permissions (no NMT)
# ============================================

ASR_NMT_TTS_LLM_PIPELINE_OCR_KEY=<jwt-token-with-group-a-permissions>
TRANSLIT_TLD_SD_LD_ALD_NER_KEY=<jwt-token-with-group-b-permissions>
VALID_TEST_TOKEN=<valid-long-lived-jwt-api-key>
INVALID_TEST_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.INVALID_PAYLOAD.INVALID_SIGNATURE

# ============================================
# AI SERVICE IDs
# ============================================

NMT_SERVICE_ID=<nmt-service-id>
ASR_SERVICE_ID=<asr-service-id>
TTS_SERVICE_ID=<tts-service-id>
TRANSLITERATION_SERVICE_ID=<transliteration-service-id>
TEXT_LANGUAGE_DETECTION_SERVICE_ID=<tld-service-id>
NER_SERVICE_ID=<ner-service-id>
OCR_SERVICE_ID=<ocr-service-id>
SPEAKER_DIARIZATION_SERVICE_ID=<sd-service-id>
LANGUAGE_DIARIZATION_SERVICE_ID=<ld-service-id>
AUDIO_LANGUAGE_DETECTION_SERVICE_ID=<ald-service-id>
LLM_SERVICE_ID=<llm-service-id>
PIPELINE_SERVICE_ID=<pipeline-service-id>

# ============================================
# API ENDPOINTS (defaults match platform v1)
# ============================================

AUTH_LOGIN=/api/v1/auth/login
AUTH_REFRESH=/api/v1/auth/refresh
AUTH_VALIDATE=/api/v1/auth/validate
AUTH_LOGOUT=/api/v1/auth/logout
AUTH_ME=/api/v1/auth/me
API_KEY_LIST=/api/v1/auth/api-keys
API_KEY_CREATE=/api/v1/auth/api-keys
API_KEY_UPDATE=/api/v1/auth/api-keys/{key_id}
API_KEY_DELETE=/api/v1/auth/api-keys/{key_id}

NMT_INFERENCE_ENDPOINT=/api/v1/nmt/inference
ASR_INFERENCE_ENDPOINT=/api/v1/asr/inference
TTS_INFERENCE_ENDPOINT=/api/v1/tts/inference
TRANSLITERATION_INFERENCE_ENDPOINT=/api/v1/transliteration/inference
TEXT_LANGUAGE_DETECTION_ENDPOINT=/api/v1/language-detection/inference
NER_INFERENCE_ENDPOINT=/api/v1/ner/inference
OCR_INFERENCE_ENDPOINT=/api/v1/ocr/inference
SPEAKER_DIARIZATION_ENDPOINT=/api/v1/speaker-diarization/inference
LANGUAGE_DIARIZATION_ENDPOINT=/api/v1/language-diarization/inference
AUDIO_LANGUAGE_DETECTION_ENDPOINT=/api/v1/audio-lang-detection/inference
LLM_INFERENCE_ENDPOINT=/api/v1/llm/inference
PIPELINE_INFERENCE_ENDPOINT=/api/v1/pipeline/inference

MODEL_MANAGEMENT_LIST=/api/v1/model-management/models
MODEL_MANAGEMENT_CREATE=/api/v1/model-management/models
MODEL_MANAGEMENT_GET=/api/v1/model-management/models
MODEL_MANAGEMENT_UPDATE=/api/v1/model-management/models
MODEL_MANAGEMENT_DELETE=/api/v1/model-management/models

SERVICE_MANAGEMENT_LIST=/api/v1/model-management/services
SERVICE_MANAGEMENT_CREATE=/api/v1/model-management/services
SERVICE_MANAGEMENT_GET=/api/v1/model-management/services
SERVICE_MANAGEMENT_UPDATE=/api/v1/model-management/services
SERVICE_MANAGEMENT_DELETE=/api/v1/model-management/services

EXPERIMENT_LIST=/api/v1/model-management/experiments
EXPERIMENT_CREATE=/api/v1/model-management/experiments
EXPERIMENT_GET=/api/v1/model-management/experiments
EXPERIMENT_UPDATE=/api/v1/model-management/experiments
EXPERIMENT_DELETE=/api/v1/model-management/experiments
EXPERIMENT_STATUS=/api/v1/model-management/experiments/{experiment_id}/status
EXPERIMENT_SELECT_VARIANT=/api/v1/model-management/experiments/select-variant
EXPERIMENT_METRICS=/api/v1/model-management/experiments/{experiment_id}/metrics

MULTI_TENANT_REGISTER_TENANT=/api/v1/multi-tenant/admin/register/tenant
MULTI_TENANT_VIEW_TENANT=/api/v1/multi-tenant/admin/view/tenant
MULTI_TENANT_LIST_TENANTS=/api/v1/multi-tenant/admin/list/tenants
MULTI_TENANT_UPDATE_TENANT=/api/v1/multi-tenant/admin/update/tenant
MULTI_TENANT_UPDATE_TENANT_STATUS=/api/v1/multi-tenant/admin/update/tenants/status
MULTI_TENANT_REGISTER_USER=/api/v1/multi-tenant/admin/register/users
MULTI_TENANT_VIEW_USER=/api/v1/multi-tenant/admin/view/user
MULTI_TENANT_LIST_USERS=/api/v1/multi-tenant/admin/list/users
MULTI_TENANT_UPDATE_USER=/api/v1/multi-tenant/admin/update/user
MULTI_TENANT_UPDATE_USER_STATUS=/api/v1/multi-tenant/admin/update/users/status
MULTI_TENANT_DELETE_USER=/api/v1/multi-tenant/admin/delete/user
MULTI_TENANT_REGISTER_SERVICE=/api/v1/multi-tenant/register/services
MULTI_TENANT_UPDATE_SERVICE=/api/v1/multi-tenant/update/services
MULTI_TENANT_LIST_SERVICES=/api/v1/multi-tenant/list/services
MULTI_TENANT_DELETE_SERVICE=/api/v1/multi-tenant/delete/services

ROLE_ASSIGN=/api/v1/auth/roles/assign
ROLE_REMOVE=/api/v1/auth/roles/remove
ROLE_GET_USER_ROLES=/api/v1/auth/roles/user/{user_id}
ROLE_LIST=/api/v1/auth/roles/list
PERMISSION_LIST=/api/v1/auth/permissions
PERMISSION_CATALOG=/api/v1/auth/permission/list

USER_LIST=/api/v1/auth/users
USER_GET=/api/v1/auth/users/{user_id}

LOGS_SEARCH=/api/v1/observability/logs/search
LOGS_AGGREGATE=/api/v1/observability/logs/aggregate
LOGS_SERVICES=/api/v1/observability/logs/services
TRACES_SEARCH=/api/v1/observability/traces/search
TRACES_GET=/api/v1/observability/traces/{trace_id}
TRACES_SERVICES=/api/v1/observability/traces/services

FEATURE_FLAG_EVALUATE=/api/v1/feature-flags/evaluate
FEATURE_FLAG_EVALUATE_BOOLEAN=/api/v1/feature-flags/evaluate/boolean
FEATURE_FLAG_EVALUATE_BULK=/api/v1/feature-flags/evaluate/bulk
FEATURE_FLAG_GET=/api/v1/feature-flags/{name}
FEATURE_FLAG_LIST=/api/v1/feature-flags/
FEATURE_FLAG_SYNC=/api/v1/feature-flags/sync

SMR_ENABLED=true
SMR_FLAG=true
